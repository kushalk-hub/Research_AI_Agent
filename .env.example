# rla configuration. Copy to `.env` and fill in: `Copy-Item .env.example .env`
#
# `.env` is gitignored -- never put a real key in this file. Placeholder values only.
# `src/rla/config.py` (`Settings`) is the authority: every variable below maps to
# one field there. All variables use the `RLA_` prefix EXCEPT `GEMINI_API_KEY` and
# `OPENAI_API_KEY`, which are read without the prefix (explicit validation_alias).
# Paths (`.env`, `data/`) resolve relative to the repo root, not the CWD, so
# running from a subdirectory is safe.
#
# Supported modes (see README "Supported modes", OPERATIONS_GUIDE §5):
#   fully-local  ollama/.. in all text roles + ollama/.. embedder, no Gemini key
#   hybrid       ollama/.. text roles + Gemini embedder (needs GEMINI_API_KEY)
#   cloud        Gemini natively, or a second provider via LiteLLM `[router]` extra
# Blank key + no usable ollama/.. role = keyless degrade mode (acquisition works,
# LLM stages are skipped).

# === GENERAL ================================================================
# Which backend serves every call. `gemini` = native Google SDK (default install,
# 7 runtime deps). `litellm` = route through LiteLLM (`pip install -e ".[router]"`).
# `ollama` = native Ollama backend (`/api/generate`, no LiteLLM import).
# Optional (default: gemini). Example: RLA_LLM_PROVIDER=litellm
# Local-vs-cloud effect: none by itself -- it selects the code path, while the
# model ids below select where requests actually go. An unrecognised value fails
# fast with `ValueError: unknown RLA_LLM_PROVIDER ...`, never a silent default.
#RLA_LLM_PROVIDER=gemini

# Declared in Settings but currently read by nothing (`config.py` sets up no
# logging because it is imported by `rla doctor --help`). Optional, inert.
# Example: RLA_LOG_LEVEL=INFO
#RLA_LOG_LEVEL=INFO

# Output locations, resolved relative to the repo root, not the CWD. Optional --
# uncomment only to redirect output. Defaults: data/, data/raw/, data/graph/.
# Local-vs-cloud effect: none; purely local filesystem paths.
# RLA_DATA_DIR=
# RLA_RAW_DIR=
# RLA_GRAPH_DIR=

# === MODEL ROUTING ==========================================================
# Per-stage model choice. Empty means "inherit", not "use nothing":
#   answer    -> RLA_ANSWER_MODEL, else RLA_STRONG_MODEL
#   query_expansion / relevance_scoring / extraction / resolution (the four
#              schema-constrained stages) -> RLA_STRUCTURED_MODEL, else RLA_FAST_MODEL
#   any other stage (e.g. doctor) -> RLA_FAST_MODEL
# Precedence per call (highest first): session override (TUI selector or
# --structured-model/--answer-model flags) > explicit model= call-site argument >
# stage role above. There is no heuristic, load balancing, or cost optimisation.

# Generic fallback; also the default for the structured role. Optional
# (default: gemini-2.5-flash-lite). `rla doctor --llm` probes roles, not this
# setting directly: it reaches this model through the structured role when
# RLA_STRUCTURED_MODEL is empty (plus the answer and embedding models).
# Free-tier keys report "limit: 0" for every Pro
# model, so both defaults sit in the flash tier. Cloud effect: billed per request.
RLA_FAST_MODEL=gemini-2.5-flash-lite
# Fallback for the answer role. Optional (default: gemini-2.5-flash).
# Cloud effect: streamed answers cost one call per question on this tier.
RLA_STRONG_MODEL=gemini-2.5-flash
# Model for the four schema-constrained stages. Optional (default: empty, i.e.
# inherits fast_model). Leave on the cheap model on a free key: a 100-paper
# corpus is ~100 extraction calls, and the free tier allows ~20 per model per DAY.
# Example: RLA_STRUCTURED_MODEL=ollama/qwen3:4b  (local: unlimited, no quota)
#RLA_STRUCTURED_MODEL=
# Model for streamed answer generation, where quality is user-visible and volume
# is one call per question. Optional (default: empty, i.e. inherits strong_model).
# Example: RLA_ANSWER_MODEL=gemini-2.5-flash
#RLA_ANSWER_MODEL=

# Operator assertion that these models honour schema-constrained output, used
# ONLY on the LiteLLM route: LiteLLM's static table reports False for any model
# it has no entry for (e.g. a self-hosted llama.cpp/Ollama server), which would
# otherwise make the capability gate refuse it for every structured stage.
# Substring-matched against bare and provider/-prefixed ids (one entry covers
# both spellings). Optional (default: empty = gate unchanged, refusal preserved).
# The native `ollama/` backend grammar-constrains via `format:` and needs NO
# declaration here. Example: RLA_STRUCTURED_OUTPUT_MODELS=qwen3:4b
#RLA_STRUCTURED_OUTPUT_MODELS=

# Bound on a single provider attempt, in seconds (must be > 0). Optional
# (default: 120). Previously provider calls had no bound, so a hung connection
# could block a stage indefinitely. Local-vs-cloud: same semantics either way;
# a slow local model may need a higher value, not a code change.
RLA_LLM_TIMEOUT_SECONDS=120

# === OLLAMA (fully-local inference) =========================================
# Native Ollama endpoint. No `/v1` and no `/api` suffix -- the backend appends
# the path it needs (`/api/generate` grammar-constrains structured output, while
# the OpenAI-compatible `/v1/chat/completions` route only prefills format
# instructions and measured ~12x slower for the same schema). Optional
# (default: http://localhost:11434). Local only: point at a remote server to
# share one Ollama instance. Example: RLA_OLLAMA_URL=http://gpu-box:11434
RLA_OLLAMA_URL=http://localhost:11434
# Whether a reasoning model emits its thinking before the answer. Optional
# (default: false). Off by default: free-form thinking interleaved with a grammar
# constraint asks for trouble. Example: RLA_OLLAMA_THINK=false
RLA_OLLAMA_THINK=false
#
# A fully local pipeline (no GEMINI_API_KEY needed -- text AND embeddings come
# from the local server, so factory.build_client/build_embedder stay usable):
#   ollama serve
#   ollama pull qwen3:4b
#   ollama pull nomic-embed-text
#   RLA_FAST_MODEL=ollama/qwen3:4b
#   RLA_STRUCTURED_MODEL=ollama/qwen3:4b
#   RLA_ANSWER_MODEL=ollama/qwen3:4b
#   RLA_EMBEDDING_MODEL=ollama/nomic-embed-text
#   RLA_LLM_DAILY_BUDGET=0
# Never route `ollama/..` ids through LiteLLM's `/v1` path (~8 s native vs ~98 s
# via LiteLLM for the same schema). Bare ids like `qwen3:4b` are REFUSED as
# ambiguous -- always write the `ollama/` prefix.
# NOTE (server side, not an RLA variable): the Ollama server runs
# OLLAMA_NUM_PARALLEL=1 here, so RLA_MAX_CONCURRENCY=4 may queue locally. Do not
# change either setting without measurement.

# === GEMINI (cloud text + embeddings) =======================================
# AI Studio API key (https://aistudio.google.com/apikey). REQUIRED for every
# cloud LLM stage; blank means keyless degrade mode (acquisition works, LLM
# stages are skipped). Not an OAuth credential: a `gcloud auth print-access-token`
# value returns 401 on every call (`rla doctor --llm` says so).
# Cloud effect: free tier is ~20 requests/day/model (per day, per model -- pacing
# does not help); `rla doctor --llm` verifies the key with live, uncached probes.
GEMINI_API_KEY=

# === OPENROUTER + FALLBACK (second provider / failover) ======================
# Credential for the secondary LLM provider. OPTIONAL -- the pipeline runs on the
# primary alone when blank. Named for the PROVIDER, not the routing role:
# credentials belong to providers, and a provider can be promoted to primary
# later. Never commit a real key. Placeholder only:
#OPENAI_API_KEY=
# (LiteLLM-route providers read their own credentials from the environment at
# call time; those pass straight through LiteLLM and are NOT rla.config fields.)

# Ordered fallback models, comma-separated, tried ONLY on recoverable faults
# (timeout, per-minute 429, 5xx, network). Optional (default: gemini-2.5-flash).
# A model named here is skipped for any stage it cannot serve (capability gate).
# Only the model being asked about is excluded from its own chain.
# Cloud effect: failover spends the fallback model's quota, not the primary's.
RLA_FALLBACK_MODELS=gemini-2.5-flash
# Fail over when the daily per-model quota is spent. Optional (default: false).
# OFF by default ON PURPOSE: quota exhaustion is a capacity condition, not a
# fault, so failing over silently spends a second model's budget on the first
# model's ceiling. Turn on only if you would rather keep running than preserve
# reserve. Accepts truthy `1` as well as `true`. Example: RLA_FALLBACK_ON_QUOTA=true
RLA_FALLBACK_ON_QUOTA=false

# Per-provider base URL overrides, as a JSON object keyed by the SAME provider
# prefix used in model strings. Optional (default: empty = provider defaults).
# A MAP rather than one global URL on purpose: two providers are live at once
# during failover, and a shared endpoint would silently break the primary.
# LiteLLM route ONLY -- the native Gemini/Ollama backends ignore it.
# The key must be a provider LiteLLM recognises (openai, openrouter, groq, ...);
# an invented prefix is rejected with "LLM Provider NOT provided" before any
# request. For a custom OpenAI-compatible server, declare it AS openai:
#   RLA_LLM_BASE_URLS={"openai": "http://localhost:8000/v1"}
#   RLA_FALLBACK_MODELS=openai/my-model
# Malformed JSON is ignored with one warning, never a crash.
#RLA_LLM_BASE_URLS=

# === EMBEDDINGS =============================================================
# Concept-embedding model. Optional (default: gemini-embedding-001, the GA
# replacement for the retired text-embedding-004, which now 404s).
# Fully-local example: RLA_EMBEDDING_MODEL=ollama/nomic-embed-text (768 dims).
RLA_EMBEDDING_MODEL=gemini-embedding-001
# Merge thresholds belong to the embedding SPACE (`thresholds_for()`), keyed by
# canonical model id. The shipped calibration (auto-merge 0.92 / judge band floor
# 0.70) applies to gemini/gemini-embedding-001 ONLY -- never reuse those numbers
# for another space. A new/uncalibrated space starts UNCALIBRATED: automatic
# merging is DISABLED (fail toward duplicates, never toward false lineage) and
# borderline pairs go to the bounded LLM judge until `rla calibrate-merges`
# PROPOSES a threshold and a human commits it (it installs nothing).

# === PIPELINE (acquisition sources + corpus bounds + phase-2 stubs) =========
# Adds a Google Scholar pass for recent preprints. Optional (default: blank =
# pass off). `rla doctor` reports a missing key as a coverage blind spot, not an
# error. Placeholder only:
RLA_SERPAPI_API_KEY=
# CORE full-text access. Declared in Settings but read by no source yet (phase 2
# stub). Optional, inert. Placeholder only:
RLA_CORE_API_KEY=
# Full-text resolution (phase 2 stubs). Unpaywall takes an email address, not a
# key. Optional, inert -- no adapter reads them yet:
RLA_UNPAYWALL_EMAIL=
RLA_GROBID_URL=
# Neo4j export (phase 2 stub). No consumer exists yet. Optional, inert:
RLA_NEO4J_URI=bolt://localhost:7687
RLA_NEO4J_USER=neo4j
RLA_NEO4J_PASSWORD=

# Corpus bounds. Optional (defaults: 40 / 100). Scoring cost scales with the kept
# corpus (candidate window = max x 3), so lower these on a free key -- e.g. a
# 30-paper corpus still needs ~2 days of one model's daily allowance.
RLA_TARGET_CORPUS_MIN=40
RLA_TARGET_CORPUS_MAX=100
# Timeout for SOURCE HTTP only (never provider calls -- see RLA_LLM_TIMEOUT_SECONDS
# above). Optional (default: 30.0).
RLA_REQUEST_TIMEOUT_SECONDS=30.0
# Retries for SOURCE HTTP only (never provider calls -- see RLA_LLM_MAX_RETRIES
# below). Optional (default: 4).
RLA_MAX_RETRIES=4
# Minimum seconds between Semantic Scholar calls; its anonymous pool is shared
# (~1 req/s). Optional (default: 1.1, 0 allowed). Local-vs-cloud: irrelevant
# locally, but keep it -- hammering a shared free index gets the IP throttled.
RLA_S2_DELAY_SECONDS=1.1

# === CACHE + CONCURRENCY (throughput, pacing, budgets) ======================
# Fan-out width for sources, extraction, and judging. Optional (default: 4,
# bounds 1..16, enforced by pydantic at startup). NOTE: with the Ollama server
# at OLLAMA_NUM_PARALLEL=1, values above 1 queue locally -- measurement first.
RLA_MAX_CONCURRENCY=4
# Shared per-minute pacing across text AND embedding calls. Optional (default:
# 15, bounds 1..60). NOT the quota fix: the free tier also caps each model per
# DAY, which no pacing gets under (`is_daily_quota` fails fast instead).
RLA_LLM_RPM=15
# Attempts per logical PROVIDER call (retry layer, `llm/retry.py`). Optional
# (default: 5, bounds 1..10). Retry-ability derives from the error category, so
# raising this never turns a 401/404 into a success -- do not "fix" quota or auth
# failures by increasing retries.
RLA_LLM_MAX_RETRIES=5
# Local cap on requests a run may spend PER MODEL, so the first stage cannot eat
# the whole day's allowance. Optional (default: 15, 0 = uncapped). Cached calls
# are never charged. Set 0 for local inference or a paid key; keep capped on a
# free key. Reset at the start of every Pipeline.run().
RLA_LLM_DAILY_BUDGET=15
# NOTE: every outbound call (HTTP and LLM) goes through the SQLite cache
# (`data/cache.db`). Cache keys include prompt_hash(prompt) + model id, so a
# second identical run costs zero network calls. There is no knob to disable the
# cache -- that is deliberate.
