# rla configuration. Copy to `.env` and fill in.
#
# Every variable is optional except GEMINI_API_KEY, and even that is not
# required: without it the pipeline degrades to the keyless sources
# (Semantic Scholar, OpenAlex, arXiv, DBLP, CrossRef) and skips the LLM
# stages. Acquisition is keyless; extraction, resolution and answering are not.
#
# Variable names are the field names from `rla.config.Settings` prefixed with
# `RLA_` -- EXCEPT the API keys below, which are read without the prefix.

# --- LLM -------------------------------------------------------------------
# AI Studio API key (not an OAuth credential -- a `gcloud auth print-access-token`
# value returns 401 on every call). Grants access to the free tier.
GEMINI_API_KEY=

# Free-tier keys report "limit: 0" for every Pro model, so both defaults sit in
# the flash tier. Change these to a paid-tier model to leave the free tier.
RLA_FAST_MODEL=gemini-2.5-flash-lite
RLA_STRONG_MODEL=gemini-2.5-flash
# gemini-embedding-001 is the GA replacement for the retired text-embedding-004.
RLA_EMBEDDING_MODEL=gemini-embedding-001

# --- Provider routing --------------------------------------------------------
# Which backend serves the calls. `gemini` uses the native SDK directly; `litellm`
# routes through the optional extra (pip install -e ".[router]"). This is the only
# setting that selects a provider - no code change is involved.
#RLA_LLM_PROVIDER=gemini

# Per-stage model choice. Left unset, each role follows fast/strong above.
# `structured_model` covers the four schema-constrained stages (query expansion,
# relevance scoring, extraction, resolution). Leave it on the cheap model unless
# you have a paid key: a 100-paper corpus is ~100 extraction calls, and the
# free tier allows ~20 per model per DAY.
#RLA_STRUCTURED_MODEL=gemini-2.5-flash

# Streamed answer generation, where quality is user-visible and volume is one
# call per question.
#RLA_ANSWER_MODEL=gemini-2.5-flash

# Ordered fallbacks, tried only on recoverable faults (timeout, per-minute 429,
# 5xx, network). A model named here is skipped for any stage it cannot serve
# without schema support.
RLA_FALLBACK_MODELS=gemini-2.5-flash

# Fail over to another model when the daily per-model quota is spent. OFF by
# default: quota exhaustion is a capacity condition rather than a fault, so
# failing over silently spends a second model's budget on the first model's
# ceiling. Turn on only if you would rather keep running than preserve reserve.
RLA_FALLBACK_ON_QUOTA=false

# Bound a single provider attempt, in seconds. Previously provider calls had no
# bound at all, so a hung connection could block a stage indefinitely.
RLA_LLM_TIMEOUT_SECONDS=120

# --- Second provider (optional) --------------------------------------------
# An independently authenticated provider, for cross-provider failover when the
# primary is unavailable. Named for the PROVIDER, not the routing role: credentials
# belong to providers, and a provider can be promoted to primary later. Add the key
# to .env yourself; never commit it.
#OPENAI_API_KEY=

# --- Per-provider base URL overrides (optional) ----------------------------
# Point any provider at an alternative endpoint: an OpenAI-compatible gateway, a
# proxy, or a self-hosted server. Keyed by the SAME provider prefix used in model
# strings. A JSON object, and a MAP rather than one global URL on purpose: two
# providers are live at once during failover, and a shared endpoint would silently
# break the primary.
#
# The key must be a provider LiteLLM actually recognises (openai, openrouter, groq,
# gemini, anthropic, ...). An invented prefix like "local" is rejected with
# "LLM Provider NOT provided" before any request is made. For a custom
# OpenAI-compatible server, declare it AS openai and override its endpoint:
#
#   RLA_LLM_BASE_URLS={"openai": "http://localhost:8000/v1"}
#   RLA_FALLBACK_MODELS=openai/my-model
#
# The credential is the one that provider reads, so the `openai` entry above sends
# OPENAI_API_KEY to your server. Set that variable to whatever your server expects.
#
# Entries are optional; an absent key means "use the provider's default endpoint",
# which is what you want for openrouter and groq.
#RLA_LLM_BASE_URLS=

# --- Self-hosted model (optional) -------------------------------------------
# Declare that a model honours schema-constrained output, when LiteLLM's own
# static table says it does not.
#
# LiteLLM reports supports_response_schema() == False for any model it has no
# entry for -- including a self-hosted llama.cpp / Ollama server that honours
# `response_format` perfectly well. Left unset, the capability gate refuses such
# a model, and because query expansion, relevance scoring, extraction and
# resolution are ALL schema-constrained stages, it becomes unusable for exactly
# the bulk work a local model is wanted for.
#
# Substring-matched against both the bare and the `provider/`-prefixed id, so one
# entry covers both spellings. Empty preserves the gate unchanged: this is an
# explicit operator assertion, never a silent assumption.
#RLA_STRUCTURED_OUTPUT_MODELS=

# A complete local-inference setup (Ollama), for when the free tier's
# ~20 requests per model per day is the binding constraint:
#
#   ollama serve
#   ollama pull qwen3:4b
#
#   RLA_LLM_PROVIDER=litellm
#   RLA_FAST_MODEL=openai/qwen3:4b
#   RLA_STRUCTURED_MODEL=openai/qwen3:4b
#   RLA_ANSWER_MODEL=openai/qwen3:4b
#   RLA_LLM_BASE_URLS={"openai": "http://localhost:11434/v1"}
#   RLA_STRUCTURED_OUTPUT_MODELS=qwen3:4b
#   RLA_LLM_DAILY_BUDGET=0
#
# Note that entity resolution still embeds concepts with Gemini (the only wired
# embedder), so keep GEMINI_API_KEY set even when every text call is local.

# --- Optional source -------------------------------------------------------
# Adds a Google Scholar pass for recent preprints. Off without a key, which
# `rla doctor` reports as a coverage blind spot rather than hiding.
RLA_SERPAPI_API_KEY=
# CORE full-text access. Declared in Settings but not read by any source yet.
RLA_CORE_API_KEY=

# --- Optional: full-text resolution (phase 2) ------------------------------
# Unpaywall takes an email address, not a key.
RLA_UNPAYWALL_EMAIL=
RLA_GROBID_URL=

# --- Optional: Neo4j export (phase 2) ---------------------------------------
RLA_NEO4J_URI=bolt://localhost:7687
RLA_NEO4J_USER=neo4j
RLA_NEO4J_PASSWORD=

# --- Pipeline tuning -------------------------------------------------------
RLA_MAX_CONCURRENCY=4
# Per-minute pacing. NOT the binding constraint: the free tier also caps each
# model at ~20 requests per DAY per model, which no amount of pacing gets under.
# `rla.llm.retry.is_daily_quota` detects that ceiling and fails fast.
RLA_LLM_RPM=15
RLA_LLM_MAX_RETRIES=5
# Local cap on requests a run may spend PER MODEL, so the first stage in a run
# cannot consume the whole day's allowance and leave nothing for the stages after
# it. Set to 0 for no cap.
RLA_LLM_DAILY_BUDGET=15
# Semantic Scholar anonymous access is roughly 1 req/s; acquisition sleeps here.
RLA_S2_DELAY_SECONDS=1.1
RLA_TARGET_CORPUS_MIN=40
RLA_TARGET_CORPUS_MAX=100
RLA_REQUEST_TIMEOUT_SECONDS=30.0
RLA_MAX_RETRIES=4
RLA_LOG_LEVEL=INFO

# --- Paths ------------------------------------------------------------------
# `rla.config` resolves all of these relative to the repo root, not the CWD, so
# running from a subdirectory is safe. Uncomment only to redirect output.
# RLA_DATA_DIR=
# RLA_RAW_DIR=
# RLA_GRAPH_DIR=
